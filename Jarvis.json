    {
      "parameters": {
        "jsCode": "const fromVoice = $input.first().json.text !== undefined;\nconst mission = fromVoice\n  ? $input.first().json.text\n  : ($input.first().json.body?.mission || $input.first().json.mission || '');\nreturn [{ json: { mission, source: fromVoice ? 'voice' : 'webhook' } }];"
      },
