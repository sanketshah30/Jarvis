    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst outputs = {\n  engineering: '(not activated)',\n  data: '(not activated)',\n  sales: '(not activated)',\n  content: '(not activated)',\n  growth: '(not activated)'\n};\n\nitems.forEach(item => {\n  const output = item.json.output || '';\n  if (!output) return;\n  const text = output.toLowerCase();\n  if (text.includes('code/architecture') || text.includes('jira') || text.includes('blockers')) {\n    outputs.engineering = output;\n  } else if (text.includes('analysis plan') || text.includes('key metrics') || text.includes('data quality')) {\n    outputs.data = output;\n  } else if (text.includes('outreach') || text.includes('crm updates') || text.includes('next stage')) {\n    outputs.sales = output;\n  } else if (text.includes('seo title') || text.includes('meta description') || text.includes('distribution')) {\n    outputs.content = output;\n  } else if (text.includes('ad copy') || text.includes('targeting') || text.includes('kpis')) {\n    outputs.growth = output;\n  }\n});\n\nreturn [{ json: {\n  outputs,\n  agents_responded: items.length,\n  timestamp: new Date().toISOString()\n} }];"
      },
