        "jsCode": "// FIX: strip Gemini markdown fences before parsing\nconst raw = $input.first().json.output || '{}';\nconst cleaned = raw.replace(/```json/gi, '').replace(/```/g, '').trim();\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch(e) {\n  parsed = { eng_task: raw };\n}\nconst result = {};\nif (parsed.eng_task && String(parsed.eng_task).trim()) result.eng_task = parsed.eng_task;\nif (parsed.data_task && String(parsed.data_task).trim()) result.data_task = parsed.data_task;\nif (parsed.tech_summary) result.tech_summary = parsed.tech_summary;\nreturn [{ json: result }];"
