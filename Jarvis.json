        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 1 },
          "conditions": [{ "id": "cto-condition", "leftValue": "={{ $json.route }}", "rightValue": "CTO", "operator": { "type": "array", "operation": "contains", "rightType": "any" } }],
          "combinator": "and"
        },
        "options": { "looseTypeValidation": true }
